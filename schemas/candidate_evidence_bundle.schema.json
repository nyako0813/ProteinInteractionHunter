{
  "$defs": {
    "CandidateDisposition": {
      "enum": [
        "included",
        "down_ranked",
        "flagged",
        "excluded"
      ],
      "title": "CandidateDisposition",
      "type": "string"
    },
    "CandidateScore": {
      "additionalProperties": false,
      "properties": {
        "annotation_confidence_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation Confidence Score"
        },
        "calculation_trace": {
          "items": {
            "type": "string"
          },
          "title": "Calculation Trace",
          "type": "array"
        },
        "contradiction_penalty": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contradiction Penalty"
        },
        "evidence_completeness": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Completeness"
        },
        "evolutionary_coupling_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evolutionary Coupling Score"
        },
        "functional_association_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Functional Association Score"
        },
        "gene_context_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene Context Score"
        },
        "physical_interaction_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Interaction Score"
        },
        "total_ranking_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Ranking Score"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "CandidateScore",
      "type": "object"
    },
    "ContradictionEvidence": {
      "additionalProperties": false,
      "properties": {
        "contradiction_type": {
          "minLength": 1,
          "title": "Contradiction Type",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "hard_exclusion": {
          "default": false,
          "title": "Hard Exclusion",
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/EvidenceOrigin",
          "default": "inferred"
        },
        "penalty": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Penalty"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/EvidenceProvenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "quality": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "severity": {
          "$ref": "#/$defs/ContradictionSeverity"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "not_run"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "contradiction_type",
        "severity",
        "explanation"
      ],
      "title": "ContradictionEvidence",
      "type": "object"
    },
    "ContradictionSeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "ContradictionSeverity",
      "type": "string"
    },
    "DomainEvidence": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accession"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "is_shared": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Shared"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "origin": {
          "$ref": "#/$defs/EvidenceOrigin",
          "default": "inferred"
        },
        "pair_rule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Rule Id"
        },
        "protein_id": {
          "minLength": 1,
          "title": "Protein Id",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/EvidenceProvenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "quality": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "role": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "not_run"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "protein_id"
      ],
      "title": "DomainEvidence",
      "type": "object"
    },
    "EvidenceOrigin": {
      "enum": [
        "exact_protein",
        "exact_pair",
        "ortholog_transferred",
        "annotation",
        "local_prediction",
        "inferred"
      ],
      "title": "EvidenceOrigin",
      "type": "string"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "source_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source_name"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "available",
        "missing",
        "not_applicable",
        "failed",
        "not_run"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "tier_a_strong_multi_evidence",
        "tier_b_moderate",
        "tier_c_exploratory",
        "tier_d_context_only",
        "tier_e_insufficient",
        "tier_x_conflicting"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },

        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "FunctionalEvidence",
      "type": "object"
    },
    "FusionEvidence": {
      "additionalProperties": false,
